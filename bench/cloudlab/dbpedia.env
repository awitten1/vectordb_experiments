# Settings for the DBpedia-OpenAI comparison on the CloudLab m510 nodes
# (8 cores / 16 threads, 62 GB RAM). Source before run_experiment.sh:
#
#   set -a; . bench/cloudlab/dbpedia.env; set +a
#   bench/run_experiment.sh data build pgvectorfast prism_solo overhead
#
# SMOKE=1 switches to the 100K subset with short windows, to shake out the
# pipeline in minutes before committing hours to the 1M set.

_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [ "${SMOKE:-0}" = 1 ]; then
  DATASET=qdrant:dbpedia-openai-100K-1536-angular
  DURATION=5
  EF_SWEEP=10,40,160
  PVF_EF_SWEEP=10,40,160
  NPROBE_SWEEP=5,20,80
  GINGER_SWEEP=10,40,160
else
  DATASET=qdrant:dbpedia-openai-1M-1536-angular
  DURATION=60
  EF_SWEEP=10,20,40,80,160,320,640,1000
  PVF_EF_SWEEP=10,20,40,80,160,320,640,1000
  NPROBE_SWEEP=5,10,20,40,80,160,320
  GINGER_SWEEP=10,20,40,80,160,320,640,1000
fi

# 1536-d float4 is ~6 KB per vector: the in-memory HNSW graph for ~1M rows is
# ~7 GB, so 16 GB of maintenance_work_mem keeps the whole build in memory.
BUILD_MWM=16GB
BUILD_SB=2GB
# Table (~7 GB) + HNSW (~8 GB) + the PRISM copy (~7.5 GB) all stay resident.
QUERY_SB=28GB
WORKERS=15

M=16
EF_CONSTRUCTION=64
CLIENTS=1,8
PVF_CLIENTS=1,8
NUM_QUERIES=1000

# Refuse to run unless the CPU clock is pinned (bench/cloudlab/pin_cpu.sh) and
# swap is off, so everything measured is in RAM and at a fixed clock.
REQUIRE_PINNED=1
REQUIRE_NO_SWAP=1

STOCK_SO="$_root/postgres/stock/vector.so"
FAST_SO="$_root/pgvectorfast/vectorfast.so"
unset _root
