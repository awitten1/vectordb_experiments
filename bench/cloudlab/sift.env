# The SIFT (128-d) side of the dimension comparison: the same machine settings
# and guards as dbpedia.env, on ann-benchmarks' sift-128-euclidean (SIFT1M:
# 1,000,000 base vectors, 10,000 queries, published exact neighbors, L2).
#
#   set -a; . bench/cloudlab/sift.env; set +a
#   ENV_FILE=bench/cloudlab/sift.env bench/cloudlab/<driver>.sh

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dbpedia.env"

DATASET=sift-128-euclidean
# A 128-d float vector is 512 B, so the 1M-row table and HNSW index are a
# fraction of DBpedia's; these limits are the same, just generous here.
