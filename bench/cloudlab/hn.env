# Settings for the Hacker News comparison (stock pgvector, pgvectorfast, Ginger)
# on two CloudLab c220g2 nodes (Wisconsin): 2x Xeon E5-2660 v3, 2 sockets x
# 10 cores x 2 threads, 160 GB RAM, AVX2. Source before run_experiment.sh:
#
#   set -a; . bench/cloudlab/hn.env; set +a
#
# Workstation-side drivers take it as ENV_FILE=bench/cloudlab/hn.env (see
# bench/cloudlab/hn_qps.sh). SMOKE=1 switches to a 1M-row subset with short
# windows, to shake out the pipeline before committing many hours to 28.7M.

_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Both runs use the same 1,000 held-out queries (see datasets.py, hackernews).
if [ "${SMOKE:-0}" = 1 ]; then
  DATASET=hackernews:1000000
  DURATION=5
  PVF_EF_SWEEP=10,40,160
  GINGER_SWEEP=10,40,160
else
  DATASET=hackernews
  DURATION=60
  PVF_EF_SWEEP=10,20,40,80,160,320,640,1000
  GINGER_SWEEP=10,20,40,80,160,320,640,1000
fi
EF_SWEEP="$PVF_EF_SWEEP"
NUM_QUERIES=1000

# 28.7M x 384-d float4: a 1.5 KB vector stays inline (under the TOAST
# threshold). Expected: heap ~46 GB, HNSW ~57 GB. The build's in-memory graph
# is about the index size (~54 GB at 1M-scaled sizes), so 80 GB of maintenance_work_mem keeps it there
# (phase_build warns if it spills). Queries need table + index resident:
# QUERY_SB is checked by prewarm_or_die, which fails if anything is left out.
BUILD_MWM=80GB
BUILD_SB=2GB
QUERY_SB=112GB
WORKERS=39

M=16
EF_CONSTRUCTION=64
CLIENTS=1
PVF_CLIENTS=1

# Both sockets, memory interleaved across them, for Postgres and Ginger alike
# (run_postgres.sh and run_ginger.sh prefix their launch with NUMA_CMD).
NUMA_CMD="numactl --interleave=all"

# The E5-2660 v3's base clock; turbo off (bench/cloudlab/pin_cpu.sh).
FREQ_KHZ=2600000
REQUIRE_PINNED=1
REQUIRE_NO_SWAP=1

STOCK_SO="$_root/postgres/stock/vector.so"
FAST_SO="$_root/pgvectorfast/vectorfast.so"

# The PiPNN arm (bench/cloudlab/hn_pipnn.sh): the awitten1/pgvectorfast fork,
# synced to pgvectorfast_pipnn/, with a graph built by Ginger's PiPNN
# (its tools/pipnn_export) on its own copy of the table. m = 32 gives layer 0
# the 64 neighbours PiPNN keeps per point. The import streams (~42 bytes of
# memory per row), so maintenance_work_mem only needs to be ordinary.
PIPNN_SO="$_root/pgvectorfast_pipnn/vectorfast.so"
PIPNN_BIN="$_root/pgvectorfast_pipnn/tools/pipnn_export/build/pipnn_export"
if [ "${SMOKE:-0}" = 1 ]; then PIPNN_TABLE=items_hn_pipnn_1m; else PIPNN_TABLE=items_hn_pipnn; fi
# On the root disk: /mydata has no room for the 7 GB graph next to the table
# copy and its index.
PIPNN_GRAPH="/var/tmp/pipnn/$PIPNN_TABLE.graph"
PIPNN_M=32
PIPNN_MWM=8GB
unset _root

# Never drop or rebuild an existing table or index (ann_bench.py refuses and
# exits): the 28.7M HNSW index takes hours and is meant to be re-measured
# under other Postgres settings. Set PROTECT_INDEXES=0 on a command to rebuild.
PROTECT_INDEXES=1

# The ntq arm (bench/cloudlab/hn_tq4.sh): pgvector_ntq's 4-bit TurboQuant
# navigation codes with ntq12 re-ranking, on its own copy of the table so the
# planner only ever sees one HNSW index per table and each arm loads only its
# own relations into shared_buffers. Short names: index names must fit 63 bytes.
if [ "${SMOKE:-0}" = 1 ]; then NTQ_TABLE=items_hn_tq4_1m; else NTQ_TABLE=items_hn_tq4; fi
NTQ_ARGS="--quantizer tq4 --rerank ntq12"
