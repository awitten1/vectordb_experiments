+/*
+ * Warm the buffer-mapping buckets for a batch of neighbor blocks.
+ *
+ * Expanding one candidate looks up ~21 scattered blocks, and measurement on an
+ * 18M-vector index put 38% of query CPU in the buffer mapping hash probe with
+ * essentially no page reuse to cache away (1.000 neighbors per distinct block,
+ * 0.79% hit rate for a recent-block cache). Each probe is a dependent miss, so
+ * they serialize. The block numbers are all known as soon as the neighbor
+ * tuple is read, so issue every bucket prefetch first and let the misses
+ * overlap.
+ */
+static inline void
+HnswPrefetchUnvisited(Relation index, HnswUnvisited * unvisited, int unvisitedLength)
+{
+	for (int i = 0; i < unvisitedLength; i++)
+	{
+		BufferTag	tag;
+
+		InitBufferTag(&tag, &index->rd_locator, MAIN_FORKNUM,
+					  ItemPointerGetBlockNumber(&unvisited[i].indextid));
+		BufTablePrefetch(BufTableHashCode(&tag));
+	}
+}
