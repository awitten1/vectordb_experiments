+/*
+ * A pinned, share-locked index page held across several element loads.
+ *
+ * Expanding one candidate loads up to 2 * m neighbor elements. Each one used
+ * to be a separate ReadBuffer, and profiling showed BufTableLookup (the buffer
+ * mapping hash probe) at ~38% of query CPU with 99% of it on this path, versus
+ * 0.8% for the actual distance arithmetic. Sorting the neighbors by block and
+ * holding one buffer across a run of same-block neighbors collapses those
+ * repeats into a single lookup and pin.
+ */
+typedef struct HnswPageCursor
+{
+	Relation	index;
+	BlockNumber blkno;			/* InvalidBlockNumber when nothing is held */
+	Buffer		buf;
+	Page		page;
+}			HnswPageCursor;
+
+static inline void
+HnswPageCursorInit(HnswPageCursor * cur, Relation index)
+{
+	cur->index = index;
+	cur->blkno = InvalidBlockNumber;
+	cur->buf = InvalidBuffer;
+	cur->page = NULL;
+}
+
+static inline void
+HnswPageCursorRelease(HnswPageCursor * cur)
+{
+	if (cur->blkno != InvalidBlockNumber)
+	{
+		UnlockReleaseBuffer(cur->buf);
+		cur->blkno = InvalidBlockNumber;
+		cur->buf = InvalidBuffer;
+		cur->page = NULL;
+	}
+}
+
+/*
+ * Make blkno the cursor's current page, reusing the pin when it already is.
+ */
+static inline Page
+HnswPageCursorGet(HnswPageCursor * cur, BlockNumber blkno)
+{
+	if (cur->blkno == blkno)
+		return cur->page;
+
+#ifdef HNSW_BLOCKSTATS
+	{
+		/* would a ReadRecentBuffer-style cache have hit here? */
+		static BlockNumber recent[256];
+		static int64 probes = 0, hits = 0;
+		int			slot = blkno & 255;
+
+		probes++;
+		if (recent[slot] == blkno)
+			hits++;
+		recent[slot] = blkno;
+		if (probes % 5000000 == 0)
+			elog(LOG, "hnsw recentcache: %ld probes, %ld hits (%.4f%% hit rate)",
+				 probes, hits, 100.0 * hits / probes);
+	}
+#endif
+
+	HnswPageCursorRelease(cur);
+
+	cur->buf = ReadBuffer(cur->index, blkno);
+	LockBuffer(cur->buf, BUFFER_LOCK_SHARE);
+	cur->blkno = blkno;
+	cur->page = BufferGetPage(cur->buf);
+
+	return cur->page;
+}
+
+/*
+ * Load an element through a page cursor, leaving the page pinned for the next
+ * caller. Same semantics as HnswLoadElementImpl otherwise.
+ */
+static void
+HnswLoadElementViaCursor(HnswPageCursor * cur, BlockNumber blkno, OffsetNumber offno, double *distance, HnswQuery * q, HnswSupport * support, bool loadVec, double *maxDistance, HnswElement * element)
+{
+	Page		page = HnswPageCursorGet(cur, blkno);
+	HnswElementTuple etup = (HnswElementTuple) PageGetItem(page, PageGetItemId(page, offno));
+
+	Assert(HnswIsElementTuple(etup));
+
+	if (unlikely(etup->deleted))
+		elog(ERROR, "cannot load deleted element");
+
+	if (distance != NULL)
+	{
+		if (DatumGetPointer(q->value) == NULL)
+			*distance = 0;
+		else
+			*distance = HnswGetDistance(q->value, PointerGetDatum(&etup->data), support);
+	}
+
+	if (distance == NULL || maxDistance == NULL || *distance < *maxDistance)
+	{
+		if (*element == NULL)
+			*element = HnswInitElementFromBlock(blkno, offno);
+
+		HnswLoadElementFromTuple(*element, etup, true, loadVec);
+	}
+}
