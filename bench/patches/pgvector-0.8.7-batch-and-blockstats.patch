 /*
  * Load an element and optionally get its distance from q
  */
@@ -819,6 +926,60 @@ HnswLoadUnvisitedFromDisk(HnswElement element, HnswUnvisited * unvisited, int *u
 		if (!found)
 			unvisited[(*unvisitedLength)++].indextid = *indextid;
 	}
+
+	/*
+	 * Sort by block so the caller's page cursor sees same-page neighbors back
+	 * to back and reads each distinct page once. Insertion sort: this array
+	 * holds at most 2 * m entries and is usually nearly sorted already, since
+	 * the build writes neighboring elements out together.
+	 *
+	 * Reordering is safe. W keeps the ef nearest elements seen and its
+	 * threshold only tightens, so an element skipped by the maxDistance test
+	 * could not have made the final result in any other order; C is a priority
+	 * queue, so pop order does not depend on insertion order either.
+	 */
+#ifdef HNSW_BLOCKSTATS
+	{
+		static int64 expansions = 0, neighbors = 0, distinct = 0;
+		BlockNumber seen[HNSW_MAX_M * 2];
+		int			nseen = 0;
+
+		for (int i = 0; i < *unvisitedLength; i++)
+		{
+			BlockNumber b = ItemPointerGetBlockNumber(&unvisited[i].indextid);
+			bool		dup = false;
+
+			for (int j = 0; j < nseen; j++)
+				if (seen[j] == b)
+				{
+					dup = true;
+					break;
+				}
+			if (!dup)
+				seen[nseen++] = b;
+		}
+		expansions++;
+		neighbors += *unvisitedLength;
+		distinct += nseen;
+		if (expansions % 200000 == 0)
+			elog(LOG, "hnsw blockstats: %ld expansions, %ld neighbors, %ld distinct blocks (%.3f neighbors/block)",
+				 expansions, neighbors, distinct, distinct ? (double) neighbors / distinct : 0);
+	}
+#endif
+
+	for (int i = 1; i < *unvisitedLength; i++)
+	{
+		HnswUnvisited hold = unvisited[i];
+		BlockNumber holdBlk = ItemPointerGetBlockNumber(&hold.indextid);
+		int			j = i - 1;
+
+		while (j >= 0 && ItemPointerGetBlockNumber(&unvisited[j].indextid) > holdBlk)
+		{
+			unvisited[j + 1] = unvisited[j];
+			j--;
+		}
+		unvisited[j + 1] = hold;
+	}
 }
 
