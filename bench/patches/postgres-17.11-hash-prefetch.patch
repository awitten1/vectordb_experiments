+/*
+ * hash_prefetch -- bring the bucket a hash value maps to into cache
+ *
+ * For a large shared table such as the buffer mapping table, the bucket
+ * lookup is a dependent cache miss: nothing else can issue until the bucket
+ * header arrives. A caller that knows several hash values up front can call
+ * this for all of them first, so the misses overlap instead of serializing.
+ *
+ * This only touches memory, so a stale or concurrently-modified bucket is
+ * harmless and no lock is needed.
+ */
+void
+hash_prefetch(HTAB *hashp, uint32 hashvalue)
+{
+#ifdef USE_PREFETCH
+	HASHHDR    *hctl = hashp->hctl;
+	uint32		bucket = calc_bucket(hctl, hashvalue);
+	HASHSEGMENT segp = hashp->dir[bucket >> hashp->sshift];
+
+	if (segp != NULL)
+		__builtin_prefetch(&segp[MOD(bucket, hashp->ssize)]);
+#endif
+}
