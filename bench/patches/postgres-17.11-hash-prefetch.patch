 /*
+ * BufTablePrefetch
+ *		Start fetching the hash bucket for a tag's hashcode into cache.
+ *
+ * Intended for callers that are about to look up several blocks whose
+ * hashcodes they already know, so the bucket misses overlap. No lock is
+ * required: this only touches memory and ignores what it finds.
+ */
+void
+BufTablePrefetch(uint32 hashcode)
+{
+	hash_prefetch(SharedBufHash, hashcode);
+}
